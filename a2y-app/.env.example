# Banco de dados
DATABASE_URL="postgresql://usuario:senha@host:5432/a2y"

# Sessão/autenticação
SESSION_SECRET="troque-por-um-segredo-forte"

# Integração com o site institucional.
# O mesmo valor deve ser configurado em A2Y_CRM_WEBHOOK_TOKEN no a2y-site.
A2Y_SITE_WEBHOOK_TOKEN=""

# Integração com o A2Y Sales Agent.
# O agente usa este token ao notificar uma reunião qualificada ao backoffice.
A2Y_AGENT_WEBHOOK_TOKEN=""
