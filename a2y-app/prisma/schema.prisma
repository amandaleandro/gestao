// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  VENDEDOR
}

model User {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  passwordHash    String
  role            UserRole @default(VENDEDOR)
  createdAt       DateTime @default(now())
  assignedClients Client[] @relation("ClientAssignedTo")
}

enum StageStatus {
  IMPORTADO
  NOVO
  CONTATADO
  INTERESSADO
  PROPOSTA_ENVIADA
  FECHADO_GANHO
  FECHADO_PERDIDO
}

model Client {
  id            String       @id @default(cuid())
  name          String
  category      String?
  phone         String?
  whatsapp      String?
  email         String?
  address       String?
  city          String?
  state         String?
  website       String?
  googleMapsUrl String?
  rating        Float?
  reviewsCount  Int?
  notes         String?
  stage         StageStatus  @default(IMPORTADO)
  source        String       @default("google_maps")
  nextContactAt DateTime?
  assignedToId  String?
  assignedTo    User?        @relation("ClientAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  activities    Activity[]
  attachments   Attachment[]

  @@index([stage])
  @@index([city])
  @@index([nextContactAt])
  @@index([assignedToId])
}

model Attachment {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fileName     String
  storedName   String
  mimeType     String
  size         Int
  createdAt    DateTime @default(now())

  @@index([clientId])
}

enum ActivityType {
  NOTA
  LIGACAO
  WHATSAPP
  EMAIL
  REUNIAO
  MUDANCA_ETAPA
}

model Activity {
  id        String       @id @default(cuid())
  clientId  String
  client    Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type      ActivityType
  content   String?
  fromStage StageStatus?
  toStage   StageStatus?
  createdAt DateTime     @default(now())

  @@index([clientId])
}

model ImportBatch {
  id          String   @id @default(cuid())
  fileName    String
  totalRows   Int
  importedRows Int
  skippedRows Int
  createdAt   DateTime @default(now())
}
